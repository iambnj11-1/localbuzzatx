{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localbuzzatx",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  }
}
