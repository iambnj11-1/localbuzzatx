---
import Layout from '../layouts/Layout.astro';
import AdRow from '../components/AdRow.astro';
---
<Layout title="About" current="About">
  <section class="page">
    <h2>About</h2>
    <p>Local Buzz ATX serves Austin, Round Rock, Georgetown, Hutto and the communities around Travis and Williamson counties with local news, practical guides, technology education and community voices. Headlines link to the original reporting.</p>
    <div class="sendbox"><b>Get in touch</b> Want to <a href="/advertise">advertise</a>, <a href="/shout-out">send a shout-out</a>, or share good news? <a href="/contact">Use the contact form →</a></div>
    <AdRow />
  </section>
</Layout>
