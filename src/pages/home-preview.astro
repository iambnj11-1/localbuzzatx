---
import Layout from '../layouts/Layout.astro';
import AdRow from '../components/AdRow.astro';
const latest = [
  ['Government', 'City council weighs a new plan for late-night transit', 'Sample headline'],
  ['Neighborhoods', 'Road work on a major commuter route starts next week', 'Sample headline'],
  ['Tech', 'A new tech hub announces hiring plans for Austin', 'Sample headline'],
  ['Weather', 'Cold front moves in for the weekend', 'Sample headline'],
];
const tea = ['Awards season is warming up', 'A tour announcement with an Austin stop', 'The trailer that took over the timeline'];
const biz = ['A major employer announces new hiring in Austin', 'What rising rents mean for renters this winter', 'Startup funding news from the local scene'];
const weekend = [['Live Music', 'Free outdoor concert downtown'], ['Family', 'Holiday market opens'], ['Food & Drink', 'New food truck park opening']];
---
<Layout title="Home preview" current="" navV2={true}>
  <p class="art-sample">Design preview with sample headlines, scores and weather. Not live.</p>

  <div class="snap">
    <div><b>Austin Snapshot</b><span>75° · Mostly sunny</span></div>
    <div class="snapscores"><b>Scores</b><span>Spurs W 112–104</span><span>Austin FC 2–1</span><span>Longhorns Sat 6 PM</span></div>
  </div>

  <section class="hero2">
    <div class="hero2img"><span>Big hero photo</span></div>
    <div class="hero2txt">
      <div class="art-kicker"><a href="/news">Top story</a><span>News</span></div>
      <h2 class="hero2h">Austin Emergency Management to host free flood preparedness training</h2>
      <p class="art-dek">Sessions are open to residents across the city. Sample two-line summary goes here.</p>
      <div class="art-why"><div class="lplabel">Why should I care?</div><p>Prepare now, before severe weather season, and know where to go.</p></div>
    </div>
  </section>

  <section class="meetbuzz">
    <div class="pagehead"><h2>Meet the Buzz</h2><span>Pick your lane</span></div>
    <div class="mbcards">
      <a class="mbcard mb-y" href="/columns-preview"><img src="/authors/caleb.jpg" alt="Caleb" width="96" height="96" /><div class="lplabel">What's Really Going On?</div><b>Caleb</b><p>Here's why you should actually care.</p></a>
      <a class="mbcard mb-r" href="/columns-preview"><img src="/authors/tori.jpg" alt="Tori" width="96" height="96" /><div class="lplabel">Quick Tea</div><b>Tori</b><p>Five things everyone's talking about.</p></a>
      <a class="mbcard mb-t" href="/columns-preview"><img src="/authors/sunny.jpg" alt="Sunny D" width="96" height="96" /><div class="lplabel">Next Up</div><b>Sunny D</b><p>What's hot right now and what's worth your time.</p></a>
    </div>
  </section>

  <section>
    <div class="pagehead"><h2>Latest headlines</h2><a href="/news">All news →</a></div>
    <ul class="latest2">
      {latest.map((l) => (<li><span class="art-kicker"><a href="/news">{l[0]}</a></span><a class="l2h" href="/news">{l[1]}</a></li>))}
    </ul>
  </section>

  <AdRow />

  <div class="trio">
    <section><div class="pagehead"><h2>What's buzzing</h2><span>Tori</span></div><ul class="miniul">{tea.map((t) => (<li><a href="/omg">{t}</a></li>))}</ul></section>
    <section><div class="pagehead"><h2>Business</h2><span>Austin economy</span></div><ul class="miniul">{biz.map((t) => (<li><a href="/money">{t}</a></li>))}</ul></section>
    <section><div class="pagehead"><h2>This weekend</h2><span>Events</span></div><ul class="miniul">{weekend.map((t) => (<li><small>{t[0]}</small><a href="/to-do">{t[1]}</a></li>))}</ul></section>
  </div>

  <div class="lpband">
    <div class="lplabel">Newsletter</div><b>The Morning Buzz</b>
    <p>The hottest Austin news in your inbox every morning. Launching soon.</p>
    <a class="adstrip-btn" href="/morning-buzz">Join the list →</a>
  </div>
</Layout>
