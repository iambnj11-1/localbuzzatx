---
import Layout from '../layouts/Layout.astro';
import AdRow from '../components/AdRow.astro';
const latest = [
  ['Government', 'City council weighs a new plan for late-night transit'],
  ['Neighborhoods', 'Road work on a major commuter route starts next week'],
  ['Tech', 'A new tech hub announces hiring plans for Austin'],
  ['Weather', 'Cold front moves in for the weekend'],
];
const buckets = [
  { key: 'y', name: 'Why It Matters', who: 'Caleb', more: 'More from Caleb', img: '/authors/caleb-v2.jpg', items: ['Austin flood training scheduled for residents', 'A new transit proposal heads to a vote', 'What a property tax change could mean for you'] },
  { key: 'r', name: 'Quick Tea', who: 'Tori', more: 'More from Tori', img: '/authors/tori.jpg', items: ['Awards season is warming up', 'A tour announcement with an Austin stop', 'The trailer that took over the timeline'] },
  { key: 't', name: 'Next Up', who: 'Sunny D', more: 'More from Sunny D', img: '/authors/sunny.jpg', items: ['A new AI tool everyone is trying', 'A streaming release people are binging', 'An app students are suddenly using'] },
  { key: 'k', name: 'Community', who: '', more: 'More Community', img: '', items: ['A new local business opens its doors', 'A school achievement worth celebrating', 'A nonprofit event this weekend'] },
];
---
<Layout title="Home preview" current="" navV2={true}>
  <p class="art-sample">Design preview with sample headlines, scores and weather. Not live.</p>
  <div class="snap"><div class="snapscores"><b>Scores</b><span>Spurs W 112–104</span><span>Austin FC 2–1</span><span>Longhorns Sat 6 PM</span></div></div>

  <section class="hero3">
    <div class="hero3main">
      <div class="hero2img"><span>Big hero photo</span></div>
      <div class="art-kicker" style="margin-top:14px"><a href="/news">Top story</a><span>News</span></div>
      <h2 class="hero2h">Austin Emergency Management to host free flood preparedness training</h2>
      <p class="art-dek">Sessions are open to residents across the city. Sample two-line summary goes here.</p>
      <div class="art-why"><div class="lplabel">Why it matters</div><p>Prepare now, before severe weather season, and know where to go.</p></div>
    </div>
    <aside class="rail">
      <div class="railbox wx3"><div class="lplabel">Austin right now</div><div class="wxrow3"><b>75°</b><span>Mostly sunny<small>High 78° · Low 58° · Sample</small></span></div></div>
      <div class="railbox"><div class="lplabel">Latest</div>
        <ul class="miniul">{latest.map((l) => (<li><small>{l[0]}</small><a href="/news">{l[1]}</a></li>))}</ul>
        <a class="railmore" href="/news">All news →</a></div>
      <div class="railbox omg3"><div class="lplabel">Around Austin</div>
        <p><b>OMG!</b> A sample one-line take goes here.</p>
        <p><b>Shout-out:</b> Happy birthday, ___! A sample shout-out.</p>
        <a class="railmore" href="/omg">More OMG! →</a> <a class="railmore" href="/shout-out">Send a shout-out →</a></div>
    </aside>
  </section>

  <div class="nlbar"><div><b>The Morning Buzz</b><span>The hottest Austin news in your inbox every morning. Launching soon.</span></div><a class="adstrip-btn" href="/morning-buzz">Join the list →</a></div>

  <section class="meetbuzz">
    <div class="pagehead"><h2>Meet the Buzz</h2><span>Pick your lane</span></div>
    <div class="mbcards">
      <a class="mbcard mb-y" href="/columns-preview"><img src="/authors/caleb-v2.jpg" alt="Caleb" width="64" height="64" /><div class="lplabel">Why It Matters</div><span class="mbtxt"><b>Caleb</b><p>Why you should care.</p></span></a>
      <a class="mbcard mb-r" href="/columns-preview"><img src="/authors/tori.jpg" alt="Tori" width="64" height="64" /><div class="lplabel">Quick Tea</div><span class="mbtxt"><b>Tori</b><p>What everyone's talking about.</p></span></a>
      <a class="mbcard mb-t" href="/columns-preview"><img src="/authors/sunny.jpg" alt="Sunny D" width="64" height="64" /><div class="lplabel">Next Up</div><span class="mbtxt"><b>Sunny D</b><p>What's hot right now.</p></span></a>
    </div>
  </section>

  <div class="buckets">
    {buckets.map((b) => (
      <section class={`bucket bk-${b.key}`}>
        <div class="bkhead">{b.img ? <img src={b.img} alt={b.who} width="36" height="36" /> : <span class="bkdot"></span>}<h3>{b.name}</h3>{b.who && <small>{b.who}</small>}</div>
        <ul class="thumbul">{b.items.map((t) => (<li><span class="thumb"></span><a href="/news">{t}</a></li>))}</ul>
        <a class="railmore" href="/columns-preview">{b.more} →</a>
      </section>
    ))}
  </div>

  <AdRow />

</Layout>
