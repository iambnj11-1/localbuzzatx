---
import Layout from '../layouts/Layout.astro';
import { getStories } from '../lib/feeds';
import { chipClass, chipLabel } from '../lib/chip';
import { getForecast } from '../lib/weather';
import CrimeBox from '../components/CrimeBox.astro';
const tags = ['News', 'Neighborhoods', 'Government', 'Development', 'Business', 'Tech', 'Busted', 'Weather'];
const crimeWords = /\b(arrest(ed|s)?|charged|indict(ed|ment)?|sentenced|convicted|guilty|pleads?|jail(ed)?|shooting|stabb\w+|robbery|burglar\w*|theft|stolen|scam\w*|fraud|dwi|suspect|manhunt|inmate|murder|homicides?)\b/i;
const label = (t: string) => (t === 'Busted' ? 'Crime' : t);
const tag = Astro.url.searchParams.get('tag');
const everything = (await getStories()).stories.filter((s) => s.category !== 'Watch' && s.category !== 'Events');
const all = tag === 'Busted' ? everything : everything.filter((s) => s.category !== 'Busted');
const pool = tag === 'Busted' ? everything.filter((s) => s.category === 'Busted' || (s.crime ?? crimeWords.test(s.title))) : tag && tags.includes(tag) ? all.filter((s) => s.category === tag) : all;
const usedPics = new Set<string>();
const stories = pool.slice(0, 40).map((s) => { if (!s.image) return s; if (usedPics.has(s.image)) return { ...s, image: undefined }; usedPics.add(s.image); return s; });
const forecast = tag === 'Weather' ? await getForecast() : null;
const lead = stories.find((s) => s.image) ?? stories[0];
const rest = stories.filter((s) => s !== lead);
const rail = rest.slice(0, 4);
const cards = rest.slice(4);
const fmt = (d: Date) => d.getTime() ? d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' }) : '';
---
<Layout title="News" current="News">
  <section class="page">
    <div class="pagehead"><h2>News</h2><span>{tag ? label(tag) : 'All the latest from Austin outlets'}</span></div>
    <div class="tags">
      <a href="/news" class={!tag ? 'on' : ''}>All</a>
      {tags.map((t) => <a href={`/news?tag=${t}`} class={tag === t ? 'on' : ''}>{label(t)}</a>)}
    </div>
    {tag === 'Busted' && <p class="crimeline">Reported by Austin outlets. An arrest is not a conviction.</p>}
    {tag === 'Weather' && (
      <div class="wxpage">
        {forecast?.alerts?.length ? <div class="alertbar"><b>Weather alerts:</b> {forecast.alerts.join(' · ')}</div> : null}
        {forecast ? (<>
          <div class="wxhero">
            <div class="wxnow"><span class="wxbig">{forecast.now.icon}</span><div><div class="wxtemp">{forecast.now.temp}°</div><div class="wxsum">{forecast.now.short}</div></div></div>
            <div class="wxstats">
              <div><b>{forecast.now.hi ?? '–'}° / {forecast.now.lo ?? '–'}°</b><span>High / Low</span></div>
              <div><b>{forecast.now.wind || '–'}</b><span>Wind</span></div>
              <div><b>{forecast.now.rain ?? 0}%</b><span>Rain chance</span></div>
            </div>
            <div class="wxloc">Austin, TX</div>
          </div>
          <h4 class="secrule">Next 12 hours</h4>
          <div class="wxhours">{forecast.hours.map((h) => (<div class="wxhr"><span>{h.time}</span><span class="wxi">{h.icon}</span><b>{h.temp}°</b><small>{h.rain ?? 0}%</small></div>))}</div>
          <h4 class="secrule">7-day forecast</h4>
          <div class="wxgrid">{forecast.days.map((d) => (
            <div class="wxday"><b>{d.name}</b><span class="wxi">{d.icon}</span><span class="wxt">{d.hi ?? '–'}° <em>{d.lo ?? '–'}°</em></span><span>{d.short}</span><small>Wind {d.wind}{d.rain != null ? ` · Rain ${d.rain}%` : ''}</small></div>
          ))}</div>
        </>) : <p>The forecast is not loading right now. Try the National Weather Service below.</p>}
        <p class="wxlinks"><b>Going somewhere else?</b> Check the forecast for any city: <a href="https://www.weather.gov" target="_blank" rel="noopener">National Weather Service (any city)</a> · <a href="https://drivetexas.org" target="_blank" rel="noopener">DriveTexas road conditions</a> · <a href="https://forecast.weather.gov/MapClick.php?lat=30.2672&lon=-97.7431" target="_blank" rel="noopener">Austin forecast details</a></p>
        <small>Forecast from the National Weather Service for Austin.</small>
      </div>
    )}
    {lead && (
      <div class="seclead">
        <article>
          {lead.image && <img src={lead.image} alt="" referrerpolicy="no-referrer" />}
          <div class="kicker"><span class={`chip ${chipClass(lead)}`}>{chipLabel(lead)}</span>{fmt(lead.date)}</div>
          <h3><a href={lead.link} target="_blank" rel="noopener">{lead.title}</a></h3>
          <p>{lead.summary}</p>
        </article>
        <aside>
          <h4>Just added</h4>
          {rail.map((s) => (
            <div class={`mini${s.image ? '' : ' noimg'}`}>{s.image && <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" />}<div><small><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span></small><a href={s.link} target="_blank" rel="noopener">{s.title}</a></div></div>
          ))}
        </aside>
      </div>
    )}
    {cards.length > 0 && <h4 class="secrule">More stories</h4>}
    <div class="cards">
      {cards.map((s) => (
        <div class="card">
          {s.image && <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" />}
          <span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span>
          <a href={s.link} target="_blank" rel="noopener">{s.title}</a>
        </div>
      ))}
    </div>
    {!stories.length && <p>Stories will show up here soon.</p>}
    {tag === 'Busted' && <CrimeBox />}
  </section>
</Layout>
