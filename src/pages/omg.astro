---
import NewsletterTools from '../components/NewsletterTools.astro';
import Layout from '../layouts/Layout.astro';
import { getStories } from '../lib/feeds';
import { withStory } from '../lib/omg';
import { chipClass, chipLabel } from '../lib/chip';
import { goodNews, shoutouts } from '../lib/community';
const stories = (await getStories()).stories.filter((s) => s.category !== 'Busted');
const all = withStory(stories);
const calm = /(crash|shoot|kill|dead|death|arrest|murder|fatal|police|suspect|stabb|assault|victim)/i;
const newsPicks = stories.filter((s) => (s.category === 'News' || s.category === 'Government') && !calm.test(`${s.title} ${s.summary}`)).slice(0, 3);
const todoPicks = stories.filter((s) => s.category === 'Events' && !/best and worst/i.test(s.title)).slice(0, 3);
const video = stories.find((s) => s.category === 'Watch' && s.videoId);
// Lead = first take that has a photo, else the first take.
const lead = all.find((r) => r.image) ?? all[0];
const rest = all.filter((r) => r !== lead);
const tag = Astro.url.searchParams.get('tag');
---
<Layout title="OMG!" current="OMG!">
  <section class="page">
    {(tag === 'Good News' || tag === 'Shout-Outs') && <>
      <div class="pagehead"><h2>{tag}</h2><span>{tag === 'Good News' ? 'Upbeat stories from around Austin' : 'Birthdays, congrats and thank-yous'}</span></div>
      <div class="omgcols">
        <div class="posts">
          {tag === 'Good News' && goodNews.map((g) => (<article class="post"><div class="kicker">Good News · Sample</div><h3>{g.head}</h3><p>{g.blurb}</p></article>))}
          {tag === 'Shout-Outs' && shoutouts.map((g) => (<article class="post"><div class="kicker">{g.kind}{(g as any).real ? '' : ' · Sample'}</div><h3>{g.who}</h3><p>{g.note}</p></article>))}
        </div>
        <aside class="omgside">
          <div class="sendbox"><b>Got one to share?</b> {tag === 'Good News' ? 'Tell us the good news happening in your corner of Austin.' : 'Birthdays, congrats, thank-yous and anniversaries.'} <a href="/contact">Send it in →</a></div>
          <NewsletterTools />
          <div class="sponsor"><div class="label">Advertise</div><b>Reach Austin readers</b>Want your business here? <a href="/contact">Get in touch →</a></div>
        </aside>
      </div>
    </>}
    {tag && tag !== 'Good News' && tag !== 'Shout-Outs' && <><p class="kicker">{tag}</p><p>Reactions for this one are coming soon. <a href="/omg">See everything</a>.</p></>}
    {!tag && <>
    <div class="pagehead"><h2>OMG!</h2><span>Austin news, with a side eye.</span></div>
    <div class="omgcols"><div>
    {all.map((r) => (
      <article class="take">
        {r.label && <div class="kicker">{r.label}</div>}
        <div class="hd">{r.head}</div>
        <p class="bigline"><em>OMG!</em> {r.line}</p>
        {r.link && <a href={r.link} target="_blank" rel="noopener">Read the story →</a>}
      </article>
    ))}
    <section class="ecosys">
      <h3 class="rule">Keep exploring Local Buzz</h3>
      <div class="ecogrid">
        <div>
          <h4><a href="/news">Latest news →</a></h4>
          {newsPicks.map((s) => (<div class="ecoitem"><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span><a href={s.link} target="_blank" rel="noopener">{s.title}</a></div>))}
        </div>
        <div>
          <h4><a href="/watch">Watch →</a></h4>
          {video ? (<a class="ecovid" href="/watch"><img src={`https://i.ytimg.com/vi/${video.videoId}/mqdefault.jpg`} alt="" loading="lazy" /><span>{video.title}</span></a>) : <p>Videos from Austin newsrooms.</p>}
        </div>
        <div>
          <h4><a href="/to-do">To Do →</a></h4>
          {todoPicks.map((s) => (<div class="ecoitem"><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span><a href={s.link} target="_blank" rel="noopener">{s.title}</a></div>))}
        </div>
      </div>
    </section>
    </div>
    <aside class="omgside">
      <div class="sendbox"><b>Good news? Birthday shout-out?</b> Share it with Austin. <a href="/contact">Send it in →</a></div>
      <NewsletterTools />
      <div class="sponsor"><div class="label">From the family</div><b>Mind the Marbles</b><em class="mtmjoke">&ldquo;I got a text Monday. It&rsquo;s Thursday.&rdquo;</em> A line from the Mind the Marbles newsletter.<br /><a class="cta" href="https://www.instagram.com/mindthemarbles/" target="_blank" rel="noopener">Follow on Instagram →</a></div>
    </aside>
    </div>
  </>}
  </section>
</Layout>
