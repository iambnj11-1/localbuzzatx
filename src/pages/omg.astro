---
import NewsletterTools from '../components/NewsletterTools.astro';
import Layout from '../layouts/Layout.astro';
import { getStories } from '../lib/feeds';
import { withStory } from '../lib/omg';
import { goodNews, shoutouts } from '../lib/community';
const { stories } = await getStories();
const all = withStory(stories);
// Lead = first take that has a photo, else the first take.
const lead = all.find((r) => r.image) ?? all[0];
const rest = all.filter((r) => r !== lead);
const tag = Astro.url.searchParams.get('tag');
---
<Layout title="OMG!" current="OMG!">
  <section class="page">
    {(tag === 'Good News' || tag === 'Shout-Outs') && <>
      <div class="pagehead"><h2>{tag}</h2><span>{tag === 'Good News' ? 'Upbeat stories from around Austin' : 'Birthdays, congrats and thank-yous'}</span></div>
      <div class="omgcols">
        <div class="posts">
          {tag === 'Good News' && goodNews.map((g) => (<article class="post"><div class="kicker">Good News · Sample</div><h3>{g.head}</h3><p>{g.blurb}</p></article>))}
          {tag === 'Shout-Outs' && shoutouts.map((g) => (<article class="post"><div class="kicker">{g.kind} · Sample</div><h3>{g.who}</h3><p>{g.note}</p></article>))}
        </div>
        <aside class="omgside">
          <div class="sendbox"><b>Got one to share?</b> {tag === 'Good News' ? 'Tell us the good news happening in your corner of Austin.' : 'Birthdays, congrats, thank-yous and anniversaries.'} <a href="/contact">Send it in →</a></div>
          <NewsletterTools />
          <div class="sponsor"><div class="label">Advertise</div><b>Reach Austin readers</b>Want your business here? <a href="/contact">Get in touch →</a></div>
        </aside>
      </div>
    </>}
    {tag && tag !== 'Good News' && tag !== 'Shout-Outs' && <><p class="kicker">{tag}</p><p>Reactions for this one are coming soon. <a href="/omg">See everything</a>.</p></>}
    {!tag && <>
    <div class="pagehead"><h2>OMG!</h2><span>Austin news, with a side eye.</span></div>
    <div class="omgcols"><div>
    <article class="omglead">
      {lead.image ? <img src={lead.image} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <div class="ph"></div>}
      <div>
        <div class="kicker">Top take{lead.label && ` · ${lead.label}`}</div>
        <h3>{lead.head}</h3>
        <div class="why"><b>Why should I care?</b>A plain, useful sentence from the story goes here soon.</div>
        <p class="bigline"><em>OMG!</em> {lead.line}</p>
        {lead.link && <a href={lead.link} target="_blank" rel="noopener">Read the story →</a>}
      </div>
    </article>
    <h3 class="rule">More takes</h3>
    <div class="omggrid">
      {rest.map((r) => (
        <div class="omgcard">
          {r.image && <img src={r.image} alt="" loading="lazy" referrerpolicy="no-referrer" />}
          {r.label && <div class="kicker">{r.label}</div>}
          <div class="hd">{r.head}</div>
          <p class="bigline sm"><em>OMG!</em> {r.line}</p>
          {r.link && <a href={r.link} target="_blank" rel="noopener">Read the story →</a>}
        </div>
      ))}
    </div>
    </div>
    <aside class="omgside">
      <div class="sendbox"><b>Good news? Birthday shout-out?</b> Share it with Austin. <a href="/contact">Send it in →</a></div>
      <NewsletterTools />
      <div class="sponsor"><div class="label">From the family</div><b>Mind the Marbles</b>Real talk. Messy minds. No need to be perfect. Plenty of us go through life thinking &ldquo;this is just who I am.&rdquo; There is more to the story, and it is okay to find out.<br /><a class="cta" href="https://www.instagram.com/mindthemarbles/" target="_blank" rel="noopener">Follow on Instagram →</a></div>
    </aside>
    </div>
  </>}
  </section>
</Layout>
