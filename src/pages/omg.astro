---
import NewsletterTools from '../components/NewsletterTools.astro';
import AdRow from '../components/AdRow.astro';
import Layout from '../layouts/Layout.astro';
import { getStories } from '../lib/feeds';
import { getTakes, ofTheDay } from '../lib/omg';
import { chipClass, chipLabel } from '../lib/chip';
import { goodNews, shoutouts } from '../lib/community';
const stories = (await getStories()).stories.filter((s) => s.category !== 'Busted' && s.category !== 'National' && s.category !== 'Entertainment');
const all = await getTakes(stories);
const daily = ofTheDay(all);
const calm = /(crash|shoot|kill|dead|death|arrest|murder|fatal|police|suspect|stabb|assault|victim)/i;
const newsPicks = stories.filter((s) => (s.category === 'News' || s.category === 'Government') && !calm.test(`${s.title} ${s.summary}`)).slice(0, 3);
const todoPicks = stories.filter((s) => s.category === 'Events' && !/best and worst/i.test(s.title)).slice(0, 3);
const video = stories.find((s) => s.category === 'Watch' && s.videoId);
// Lead = first take that has a photo, else the first take.
const tag = Astro.url.searchParams.get('tag');
---
<Layout title="OMG!" current="OMG!">
  <section class="page">
    {(tag === 'Good News' || tag === 'Shout-Outs') && <>
      <div class="pagehead"><h2>{tag}</h2><span>{tag === 'Good News' ? 'Upbeat stories from around Austin' : 'Birthdays, congrats and thank-yous'}</span></div>
      <div class="omgcols">
        <div class="posts">
          {tag === 'Good News' && goodNews.map((g) => (<article class="post"><div class="kicker">Good News · Sample</div><h3>{g.head}</h3><p>{g.blurb}</p></article>))}
          {tag === 'Shout-Outs' && shoutouts.map((g) => (<article class="post"><div class="kicker">{g.kind}{(g as any).real ? '' : ' · Sample'}</div><h3>{g.who}</h3><p>{g.note}</p></article>))}
        </div>
        <aside class="omgside">
          <div class="sendbox"><b>Got one to share?</b> {tag === 'Good News' ? 'Tell us the good news happening in your corner of Austin.' : 'Birthdays, congrats, thank-yous and anniversaries.'} <a href="/shout-out">Send it in →</a></div>
          <NewsletterTools />
          <div class="sponsor"><div class="label">Advertise</div><b>Reach Austin readers</b>Want your business here? <a href="/advertise">Advertise with us →</a></div>
        </aside>
      </div>
    </>}
    {tag && tag !== 'Good News' && tag !== 'Shout-Outs' && <><p class="kicker">{tag}</p><p>Reactions for this one are coming soon. <a href="/omg">See everything</a>.</p></>}
    {!tag && <>
    <div class="pagehead"><h2>OMG!</h2><span>Austin news, with a side eye.</span></div>
    <div class="omgcols"><div>
    <section class="omgday">
      <span class="omgbox-k">OMG! of the Day</span>
      <p class="omgday-line">{daily.line}</p>
      <p class="omgday-story">{daily.head}{daily.label ? ` · ${daily.label}` : ''}</p>
      <div class="omgshare">
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(daily.line + ' via @LocalBuzzATX')}&url=${encodeURIComponent('https://localbuzzatx.com/omg')}`} target="_blank" rel="noopener">Share on X</a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent('https://localbuzzatx.com/omg')}`} target="_blank" rel="noopener">Facebook</a>
        <button type="button" data-copy={`${daily.line} https://localbuzzatx.com/omg`}>Copy</button>
      </div>
    </section>
    <div class="omgcards">
    {all.map((r, i) => (<>
      <article class={`omgc${r.image ? '' : ' omgc-compact'}`}>
        {r.image ? (
          <div class="omgc-img">
            <img src={r.image} alt="" loading="lazy" referrerpolicy="no-referrer" />
            {r.label && <span class="omgc-src">{r.label}</span>}
          </div>
        ) : (r.label && <span class="omgc-src omgc-src-flat">{r.label}</span>)}
        <div class="omgc-body">
          <div class="omgc-head">{r.head}</div>
          <p class="omgc-line"><img class="omgc-badge" src="/omg-badge.svg" alt="OMG!" width="54" height="36" /><span>{r.line}</span></p>
          <div class="omgshare omgshare-sm">
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(r.line)}&url=${encodeURIComponent('https://localbuzzatx.com/omg')}`} target="_blank" rel="noopener">X</a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent('https://localbuzzatx.com/omg')}`} target="_blank" rel="noopener">Facebook</a>
            <button type="button" data-copy={`${r.line} https://localbuzzatx.com/omg`}>Copy</button>
          </div>
          {r.link && <a class="omgc-go" href={r.link} target="_blank" rel="noopener">Read the story →</a>}
        </div>
      </article>
      {(i + 1) % 4 === 0 && <div class="omgc-ad"><AdRow /></div>}
    </>))}
    </div>
    <section class="ecosys">
      <h3 class="rule">Keep exploring Local Buzz</h3>
      <div class="ecogrid">
        <div>
          <h4><a href="/news">Latest news →</a></h4>
          {newsPicks.map((s) => (<div class="ecoitem"><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span><a href={s.link} target="_blank" rel="noopener">{s.title}</a></div>))}
        </div>
        <div>
          <h4><a href="/watch">Watch →</a></h4>
          {video ? (<a class="ecovid" href="/watch"><img src={`https://i.ytimg.com/vi/${video.videoId}/mqdefault.jpg`} alt="" loading="lazy" /><span>{video.title}</span></a>) : <p>Videos from Austin newsrooms.</p>}
        </div>
        <div>
          <h4><a href="/to-do">To Do →</a></h4>
          {todoPicks.map((s) => (<div class="ecoitem"><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span><a href={s.link} target="_blank" rel="noopener">{s.title}</a></div>))}
        </div>
      </div>
    </section>
    </div>
    <aside class="omgside">
      <div class="sendbox"><b>Good news? Birthday shout-out?</b> Share it with Austin. <a href="/shout-out">Send it in →</a></div>
      <NewsletterTools />
      <div class="sponsor"><div class="label">From the family</div><b>Mind the Marbles</b><em class="mtmjoke">&ldquo;I got a text Monday. It&rsquo;s Thursday.&rdquo;</em> A line from the Mind the Marbles newsletter.<br /><a class="cta" href="/mind-the-marbles">Read the column →</a></div>
    </aside>
    </div>
  </>}
  </section>
<script is:inline>
  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('[data-copy]');
    if (!b) return;
    var t = b.getAttribute('data-copy');
    var done = function () { var o = b.textContent; b.textContent = 'Copied!'; setTimeout(function () { b.textContent = o; }, 1500); };
    if (navigator.clipboard) navigator.clipboard.writeText(t).then(done); else done();
  });
</script>
</Layout>
