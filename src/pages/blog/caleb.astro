---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import OmgBox from '../../components/OmgBox.astro';
import BreakingBand from '../../components/BreakingBand.astro';
import { getStories } from '../../lib/feeds';
import { getTakes, ofTheDay } from '../../lib/omg';
import { byAuthor, authors, fmtDate, laneBadge, readMin } from '../../lib/posts';
const a = authors.caleb;
const all = byAuthor('caleb');
const hero = all.find((p) => p.hero) ?? all.find((p) => !p.teaser);
const latest = all.filter((p) => !p.teaser && p !== hero).slice(0, 4);
// Caleb's Corner = journal and reflection. Caleb Reports = short sourced segments on what's hot.
const corner = all.filter((p) => p.lane === 'Caleb’s Corner');
const reports = all.filter((p) => p.lane === 'Caleb Reports');
// Same daily OMG! pick as the home page.
const feed = await getStories();
const omgAll = await getTakes(feed.stories.filter((x) => x.category !== 'Watch' && x.category !== 'National' && x.category !== 'Entertainment'));
const brk = [...feed.stories].filter((x) => x.image && x.category !== 'Watch' && x.category !== 'National' && x.category !== 'Entertainment').sort((x, y) => (y.impact ?? 0) - (x.impact ?? 0) || +new Date(y.date) - +new Date(x.date))[0];
const techRe = /\b(AI|A\.I\.|artificial intelligence|cyber|hack|ransomware|chip|semiconductor|software|data center|tech)\b/i;
const techStory = [...feed.stories].filter((x) => x !== brk && x.category !== 'Watch' && x.category !== 'National' && x.category !== 'Entertainment' && (x.category === 'Tech' || techRe.test(`${x.title} ${x.summary}`))).sort((x, y) => (y.impact ?? 0) - (x.impact ?? 0) || +new Date(y.date) - +new Date(x.date))[0];
const ownPost = all.find((x) => x.lane === 'Caleb Reports' && !x.teaser);
const side = techStory ? { label: 'Tech & AI', title: techStory.title, why: techStory.why || techStory.summary, source: techStory.source, link: techStory.link, own: false } : ownPost ? { label: 'Tech & AI', title: ownPost.title, why: ownPost.dek, source: 'Caleb', link: `${a.path}/${ownPost.slug}`, own: true } : undefined;
const omgPick = ofTheDay(omgAll);
---
<Layout title="Caleb" current="">
  <section class="page blogpage caleb">
    <p><a href="/blog">← Blog</a></p>
    <div class="pagehead"><h2>Caleb</h2><span>{a.tagline}</span></div>
    <div class="abanner abanner-caleb">
      <img src={a.img} alt="Illustration of Caleb" width="400" height="400" />
      <div><span class="abk">Caleb’s Corner</span><b>Cybersecurity and tech, in plain English.</b><small>Scams, online safety and what it all means for Austin.</small></div>
    </div>

    {hero && (
      <section class="thero">
        <a class="thero-lead" href={`${a.path}/${hero.slug}`}>
          {hero.cover
            ? <img src={hero.cover.src} alt={hero.cover.alt} width="1400" height="933" />
            : <div class="pcimg pctxt"><span>{laneBadge(hero.lane)}</span></div>}
          <span class="pctag">📌 Top story · {hero.lane}</span>
          <h3>{hero.title}</h3>
          <p>{hero.dek}</p>
          <div class="pcmeta"><img src={a.img} alt="" width="24" height="24" /><span>By Caleb</span><span>🕒 {readMin(hero)} min read</span><span>{fmtDate(hero.date)}</span></div>
        </a>
        <aside class="thero-side">
          <div class="tlatest">
            <h4>Latest from Caleb</h4>
            <ul>{latest.map((m) => <li><a href={`${a.path}/${m.slug}`}>{m.title}</a><small>{m.lane} · {fmtDate(m.date)}</small></li>)}</ul>
          </div>
          <OmgBox pick={omgPick} />
        </aside>
      </section>
    )}

    <section class="tsection">
      <div class="prowhead"><h3>📓 Caleb’s Corner</h3><span>What Caleb thinks, feels, notices, and wants to write about.</span></div>
      {corner.length
        ? <div class="pgrid">{corner.map((p) => <PostCard post={p} />)}</div>
        : <p class="art-sample">Caleb’s first Corner entry is on the way.</p>}
    </section>

    <section class="prow">
      <div class="prowhead"><h3>📰 Caleb Reports</h3><span>What’s happening in the community and what locals need to know.</span></div>
      <div class="pgrid">{reports.map((p) => <PostCard post={p} />)}</div>
    </section>

    <BreakingBand story={brk} side={side} />

    <AuthorBox who="caleb" />
  </section>
</Layout>
