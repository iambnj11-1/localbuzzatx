---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { byAuthor, authors, fmtDate, laneBadge, readMin } from '../../lib/posts';
const a = authors.caleb;
const all = byAuthor('caleb');
const hero = all.find((p) => p.hero) ?? all.find((p) => !p.teaser);
const latest = all.filter((p) => !p.teaser && p !== hero).slice(0, 4);
const takes = all.filter((p) => !p.teaser && p.take);
const rows = [
  { icon: '🔐', name: 'Cybersecurity', sub: 'Plain-English security for small businesses and everyday people.' },
  { icon: '🤖', name: 'AI & Tech', sub: 'What the AI boom means for your work, your bill and your city.' },
  { icon: '💼', name: 'Business & Growth', sub: 'Austin’s growth, and who shares in it.' },
].map((r) => ({ ...r, items: all.filter((p) => p.topic === r.name && p !== hero) })).filter((r) => r.items.length);
---
<Layout title="Caleb's Corner" current="">
  <section class="page blogpage caleb">
    <p><a href="/blog">← Blog</a></p>
    <div class="pagehead"><h2>Caleb’s Corner</h2><span>{a.tagline}</span></div>

    {hero && (
      <section class="thero">
        <a class="thero-lead" href={`${a.path}/${hero.slug}`}>
          {hero.cover
            ? <img src={hero.cover.src} alt={hero.cover.alt} width="1400" height="933" />
            : <div class="pcimg pctxt"><span>{laneBadge(hero.lane)}</span></div>}
          <span class="pctag">📌 Top story · {hero.topic ?? hero.lane}</span>
          <h3>{hero.title}</h3>
          <p>{hero.dek}</p>
          <div class="pcmeta"><img src={a.img} alt="" width="24" height="24" /><span>By Caleb</span><span>🕒 {readMin(hero)} min read</span><span>{fmtDate(hero.date)}</span></div>
        </a>
        <aside class="thero-side">
          <div class="tlatest">
            <h4>Latest from Caleb</h4>
            <ul>{latest.map((m) => <li><a href={`${a.path}/${m.slug}`}>{m.title}</a><small>{m.topic ?? m.lane} · {fmtDate(m.date)}</small></li>)}</ul>
          </div>
        </aside>
      </section>
    )}

    <section class="tsection">
      <div class="prowhead"><h3>💡 Caleb’s Take</h3><span>The short version: what it means, in Caleb’s words.</span></div>
      <div class="takecards">
        {takes.map((p) => (
          <a class="takecard" href={`${a.path}/${p.slug}`}>
            <p>“{p.take}”</p>
            <small>From: {p.title}</small>
          </a>
        ))}
      </div>
    </section>

    {rows.map((r) => (
      <section class="prow">
        <div class="prowhead"><h3>{r.icon} {r.name}</h3><span>{r.sub}</span></div>
        <div class="pgrid">{r.items.map((p) => <PostCard post={p} />)}</div>
      </section>
    ))}

    <AuthorBox who="caleb" />
  </section>
</Layout>
