---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { byAuthor, authors } from '../../lib/posts';
const a = authors.caleb;
const all = byAuthor('caleb');
---
<Layout title="Caleb's Corner" current="">
  <section class="page blogpage caleb">
    <p><a href="/blog">← Blog</a></p>
    <div class="pagehead"><h2>Caleb’s Corner</h2><span>{a.tagline}</span></div>
    <section class="prow">
      <div class="prowhead"><h3>Latest</h3><span>What happened, why it matters, and what it means for Austin. General information, not financial advice.</span></div>
      <div class="pgrid">{all.map((p) => <PostCard post={p} />)}</div>
    </section>
    <AuthorBox who="caleb" />
  </section>
</Layout>
