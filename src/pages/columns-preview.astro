---
import Layout from '../layouts/Layout.astro';
import AdRow from '../components/AdRow.astro';
const items = [
  ['Awards season is warming up', 'A one or two line summary of what happened, from the public headline.', 'My take: one short, fun opinion line goes here.'],
  ['A streaming show everyone is talking about', 'A one or two line summary of what happened, from the public headline.', 'My take: one short, fun opinion line goes here.'],
  ['A tour announcement with an Austin stop', 'A one or two line summary of what happened, from the public headline.', 'My take: one short, fun opinion line goes here.'],
  ['A celebrity birthday worth a shout-out', 'A one or two line summary of what happened, from the public headline.', 'My take: one short, fun opinion line goes here.'],
  ['The trailer that took over the timeline', 'A one or two line summary of what happened, from the public headline.', 'My take: one short, fun opinion line goes here.'],
];
---
<Layout title="Columns preview" current="">
  <section class="page">
    <p class="art-sample">Design preview with sample text and placeholder names. Not live.</p>
    <div class="pagehead"><h2>Our columnists</h2><span>Three voices, one Austin</span></div>
    <div class="colcards">
      <a class="colcard" href="#caleb">
        <img class="art-av art-av-lg" src="/authors/caleb-v2.jpg" alt="Illustration of Caleb" width="56" height="56" />
        <div><div class="lplabel">Why It Matters</div><b>Caleb</b><p>Austin news, broken down for your money, your tech and your everyday life. Analytical, clear and no hype.</p></div>
      </a>
      <a class="colcard" href="#tea">
        <img class="art-av art-av-lg" src="/authors/tori.jpg" alt="Illustration of Tori" width="56" height="56" />
        <div><div class="lplabel">Quick Tea</div><b>Tori</b><p>Celebrity news, awards, drama and whatever everyone is talking about. Five quick topics, one honest take on each.</p></div>
      </a>
      <a class="colcard" href="#buzzing">
        <img class="art-av art-av-lg" src="/authors/sunny.jpg" alt="Illustration of Sunny D" width="56" height="56" />
        <div><div class="lplabel">Next Up</div><b>Sunny D</b><p>The latest in gadgets, movies, music and trends. What's hot right now, and what's worth your time.</p></div>
      </a>
    </div>

    <div class="pagehead" id="tea"><h2>Quick Tea</h2><span>by Tori · entertainment and current events</span></div>
    <div class="fitgrid">
      <article class="fitlead">
        <div class="art-kicker"><a href="#tea">Quick Tea</a><span>This week</span></div>
        <h3 class="fith">Quick Tea: five things people are talking about</h3>
        <div class="art-by"><img class="art-av" src="/authors/tori.jpg" alt="Illustration of Tori" width="40" height="40" /><span><b>By Tori</b><small>Local Buzz ATX · Nov 11, 2026 · 2 min read</small></span></div>
        <ol class="teaitems">
          {items.map((it) => (<li><b>{it[0]}</b><p>{it[1]}</p><p class="teatake">{it[2]}</p></li>))}
        </ol>
        <p class="aitag">AI-assisted column by Tori, a pen name. Based on public reporting; rumors and unconfirmed claims are left out. <a href="/about">About the columns</a></p>
      </article>
      <aside class="fitside">
        <div class="sendbox"><b>Earlier Quick Tea</b></div>
        <ul class="fitlist">
          <li><a href="#tea">Quick Tea: last week's rundown</a><small>2 min</small></li>
          <li><a href="#tea">Quick Tea: awards edition</a><small>2 min</small></li>
          <li><a href="#tea">Quick Tea: the Austin stop edition</a><small>2 min</small></li>
        </ul>
        <div class="sponsor"><div class="label">Ad</div><b>Your business here</b><a href="/advertise">Advertise with us</a></div>
      </aside>
    </div>
    <AdRow />
  </section>
</Layout>
