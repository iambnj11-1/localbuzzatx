---
import Layout from '../layouts/Layout.astro';
import { getStories } from '../lib/feeds';
import { chipClass, chipLabel } from '../lib/chip';
const { stories, sources } = await getStories();
const heavy = /(sexual|abuse|murder|killed|shot|shooting|stabb|arrest|sentenced|dead|death|crash|rape|assault|kidnap|molest|fatal|suspect|police)/i;
const friendly = stories.filter((s) => !heavy.test(s.title) && !heavy.test(s.summary));
const top = friendly.find((s) => s.summary && s.category === 'News') ?? friendly[0] ?? stories[0];
const latest = stories.filter((s) => s !== top).slice(0, 6);
const pick = (cat: string) => stories.filter((s) => s.category === cat && s !== top).slice(0, 4);
const blocks = [['News', pick('News')], ['Neighborhoods', pick('Neighborhoods')], ['Government', pick('Government')], ['Development', pick('Development')], ['Events', pick('Events')]] as const;
const fmt = (d: Date) => d.getTime() ? d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' }) : '';
---
<Layout current="Home">
  {top ? (
    <section class="lead">
      <article>
        <div class="kicker"><span class={`chip ${chipClass(top)}`}>{chipLabel(top)}</span>Top story</div>
        <h2><a href={top.link} rel="noopener" target="_blank">{top.title}</a></h2>
        <p>{top.summary}</p>
        <p><a href={top.link} rel="noopener" target="_blank">Read the full story at {top.source} →</a></p>
        <div class="why"><b>Why should I care?</b>One plain sentence on what this means for people in Austin goes here soon.</div>
      </article>
      <aside class="side">
        <h3>Latest</h3>
        {latest.map((s) => (
          <div class="item"><span><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span>{fmt(s.date)}</span><div><a href={s.link} rel="noopener" target="_blank">{s.title}</a></div></div>
        ))}
      </aside>
    </section>
  ) : (
    <section class="page"><h2>Stories are on the way</h2><p>Check back soon.</p></section>
  )}
  <section class="grid">
    {blocks.filter(([, items]) => items.length > 0).map(([name, items]) => (
      <div>
        <h3 class="section"><a href={`/${name.toLowerCase()}`} style="text-decoration:none">{name}</a></h3>
        {items.map((s) => (
          <div class="item"><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span><div><a href={s.link} rel="noopener" target="_blank">{s.title}</a></div></div>
        ))}
      </div>
    ))}
  </section>
  <p class="tagline" style="text-align:center;margin-top:28px">Headlines from {sources.length ? sources.join(', ') : 'local outlets'}. Each link goes to the original story.</p>
</Layout>
