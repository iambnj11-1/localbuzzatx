---
import Layout from '../layouts/Layout.astro';
import { getStories } from '../lib/feeds';
import { chipClass, chipLabel } from '../lib/chip';
import { withStory } from '../lib/omg';
import { getAi } from '../lib/ai';
import VisionCareAd from '../components/VisionCareAd.astro';
const all = await getStories();
const heavy = /(sexual|abuse|murder|killed|shot|shooting|stabb|arrest|sentenced|dead|death|crash|rape|assault|kidnap|molest|fatal|suspect|police|child|children)/i;
// Homepage skips crime and tragedy stories. They still appear on the News page.
const stories = all.stories.filter((s) => s.category !== 'Watch' && !heavy.test(s.title) && !heavy.test(s.summary));
const sources = all.sources;
const videos = all.stories.filter((s) => s.category === 'Watch' && s.videoId).slice(0, 3);
const friendly = stories.filter((s) => !heavy.test(s.title) && !heavy.test(s.summary));
const top = friendly.find((s) => s.summary && s.category === 'News') ?? friendly[0] ?? stories[0];
const perSrc: Record<string, number> = {};
const latest = stories.filter((s) => s !== top).filter((s) => (perSrc[s.source] = (perSrc[s.source] ?? 0) + 1) <= 2).slice(0, 6);
const pick = (cat: string) => stories.filter((s) => s.category === cat && s !== top).slice(0, 4);
const newsItems = pick('News').slice(0, 4);
const events = pick('Events').slice(0, 4);
const takes = withStory(all.stories.filter((s) => s.category !== 'Watch')).filter((r) => r.link || true).slice(0, 2);
const gov = pick('Government').slice(0, 3);
const dev = pick('Development').slice(0, 3);
const hood = pick('Neighborhoods').slice(0, 4);
// What Matters Today: up to 3 non-crime stories, one per outlet, prefer government and development.
const used = new Set<string>();
const roundup = /(last update|everything you need to know|newsletter|week in review)/i;
const briefing = [...friendly.filter((s) => s !== top && (s.category === 'Government' || s.category === 'Development')), ...friendly.filter((s) => s !== top)]
  .filter((s) => !roundup.test(s.title))
  .filter((s) => (used.has(s.source) ? false : (used.add(s.source), true)))
  .slice(0, 3);
const taken = new Set([top, ...latest, ...briefing]);
const seenSrc = new Set<string>();
const featured = stories.filter((x) => x.image && !taken.has(x)).filter((x) => (seenSrc.has(x.source) ? false : (seenSrc.add(x.source), true))).slice(0, 3);
const ai = await getAi((Astro.locals as any).runtime?.env, top, briefing);
const fmt = (d: Date) => d.getTime() ? d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' }) : '';
---
<Layout current="Home">
  {briefing.length > 0 && (
    <section class="wmt">
      <span class="lab">What matters today</span>
      {briefing.map((s, i) => (
        <>{i > 0 && <span class="sep">•</span>}<a href={s.link} target="_blank" rel="noopener" title={s.title}>{ai?.briefing?.[i] || s.title}</a></>
      ))}
    </section>
  )}
  {top ? (
    <section class="lead">
      <article class="hero">
        {top.image && <img src={top.image} alt="" referrerpolicy="no-referrer" />}
        <div class="kicker"><span class={`chip ${chipClass(top)}`}>{chipLabel(top)}</span>Top story</div>
        <h2><a href={top.link} rel="noopener" target="_blank">{top.title}</a></h2>
        <p>{top.summary}</p>
        <p><a href={top.link} rel="noopener" target="_blank">Read the full story at {top.source} →</a></p>
        <div class="why"><b>Why should I care?</b>{ai?.why ?? 'One plain sentence on what this means for people in Austin goes here soon.'}</div>
      </article>
      <aside class="side">
        <h3>Latest</h3>
        {latest.map((s) => (
          <div class={`item latest${s.image ? '' : ' noimg'}`}>{s.image && <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" />}<div><span><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span>{fmt(s.date)}</span><div><a href={s.link} rel="noopener" target="_blank">{s.title}</a></div></div></div>
        ))}
        <div class="sponsor">
          <div class="label">Sponsored</div>
          <b>Start your own newsletter</b>
          EmailOctopus lets you send email to your first 2,500 subscribers for free.
          <br /><a class="cta" href="https://tolt.link/lba" target="_blank" rel="sponsored noopener">Try EmailOctopus free →</a>
          <small>This is an affiliate link. If you sign up, Local Buzz ATX may earn a commission at no cost to you.</small>
        </div>
      </aside>
    </section>
  ) : (
    <section class="page"><h2>Stories are on the way</h2><p>Check back soon.</p></section>
  )}

  {featured.length === 3 && (
    <section class="feat">
      <h3 class="rule">Featured</h3>
      <div class="featgrid">
        <a class="big" href={featured[0].link} target="_blank" rel="noopener">
          <img src={featured[0].image} alt="" loading="lazy" referrerpolicy="no-referrer" />
          <div class="cap"><span>{chipLabel(featured[0])}</span><b>{featured[0].title}</b></div>
        </a>
        <div class="smalls">
          {featured.slice(1).map((x) => (
            <a href={x.link} target="_blank" rel="noopener"><img src={x.image} alt="" loading="lazy" referrerpolicy="no-referrer" /><span class={`chip ${chipClass(x)}`}>{chipLabel(x)}</span><b>{x.title}</b></a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="pair">
    <div>
      <h3 class="section"><a href="/news">News</a></h3>
      {newsItems.map((s) => (
        <div class={`mini${s.image ? '' : ' noimg'}`}>{s.image && <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" />}<div><a href={s.link} rel="noopener" target="_blank">{s.title}</a><small><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span></small></div></div>
      ))}
    </div>
    <div>
      <h3 class="section omgh"><a href="/omg">OMG!</a></h3>
      {takes.map((r) => (
        <div class="omgmini"><div class="hd">{r.head}{r.label && ` · ${r.label}`}</div><p><em>OMG!</em> {r.line}</p>{r.link && <a href={r.link} target="_blank" rel="noopener">Read the story →</a>}</div>
      ))}
      <p><a href="/omg">More OMG! →</a></p>
    </div>
  </section>

  <section class="pair" style="margin-top:20px;padding-top:18px;border-top:1px solid #bdbab0">
    <div>
      <h3 class="section"><a href="/news?tag=Government">Government</a></h3>
      {gov.map((s) => (
        <div class={`mini${s.image ? '' : ' noimg'}`}>{s.image && <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" />}<div><a href={s.link} rel="noopener" target="_blank">{s.title}</a><small><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span></small></div></div>
      ))}
    </div>
    <div>
      <h3 class="section"><a href="/news?tag=Development">Development</a></h3>
      {dev.map((s) => (
        <div class={`mini${s.image ? '' : ' noimg'}`}>{s.image && <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" />}<div><a href={s.link} rel="noopener" target="_blank">{s.title}</a><small><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span></small></div></div>
      ))}
    </div>
  </section>

  <section class="pair" style="margin-top:20px;padding-top:18px;border-top:1px solid #bdbab0">
    <div>
      <h3 class="section"><a href="/watch">Watch</a></h3>
      {videos.length ? videos.map((v) => (
        <div class="mini"><a href="/watch"><img src={v.image} alt="" loading="lazy" /></a><div><a href="/watch">{v.title}</a><small><span class={`chip ${chipClass(v)}`}>{chipLabel(v)}</span></small></div></div>
      )) : <p>Videos are on the way.</p>}
    </div>
    <div>
      <h3 class="section"><a href="/to-do">To Do</a></h3>
      {events.map((s) => (
        <div class={`mini${s.image ? '' : ' noimg'}`}>{s.image && <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" />}<div><a href={s.link} rel="noopener" target="_blank">{s.title}</a><small><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span></small></div></div>
      ))}
    </div>
  </section>

  {hood.length > 0 && (
    <section class="pair" style="margin-top:20px;padding-top:18px;border-top:1px solid #bdbab0;grid-template-columns:1fr">
      <div>
        <h3 class="section"><a href="/news?tag=Neighborhoods">Neighborhoods</a></h3>
        {hood.map((s) => (
          <div class="item"><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span><div><a href={s.link} rel="noopener" target="_blank">{s.title}</a></div></div>
        ))}
      </div>
    </section>
  )}

  <VisionCareAd />
  <section class="mtm">
    <div><div class="k">From Mind the Marbles</div><b>News tells you what happened. Mind the Marbles explores what it means.</b><p>Real talk about the stuff rattling around in your head.</p></div>
    <a href="https://www.instagram.com/mindthemarbles/" target="_blank" rel="noopener">Follow on Instagram →</a>
  </section>

</Layout>
