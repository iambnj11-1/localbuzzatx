---
import Layout from '../layouts/Layout.astro';
import { getStories } from '../lib/feeds';
import { chipClass, chipLabel } from '../lib/chip';
import { withStory } from '../lib/omg';
import BannerBand from '../components/BannerBand.astro';
import { getAi } from '../lib/ai';
import NewsletterTools from '../components/NewsletterTools.astro';
import TechEventsAd from '../components/TechEventsAd.astro';
const all = await getStories();
const heavy = /(sexual|abuse|murder|killed|shot|shooting|stabb|arrest|sentenced|dead|death|crash|rape|assault|kidnap|molest|fatal|suspect|police|child|children)/i;
// Homepage skips crime and tragedy stories. They still appear on the News page.
const stories = all.stories.filter((s) => s.category !== 'Watch' && s.category !== 'Busted' && !heavy.test(s.title) && !heavy.test(s.summary));
const sources = all.sources;
const videos = all.stories.filter((s) => s.category === 'Watch' && s.videoId).slice(0, 3);
const friendly = stories.filter((s) => !heavy.test(s.title) && !heavy.test(s.summary));
const top = friendly.find((s) => s.summary && s.category === 'News' && s.image) ?? friendly.find((s) => s.summary && s.image) ?? friendly.find((s) => s.summary && s.category === 'News') ?? friendly[0] ?? stories[0];
// Top stories carousel: up to 4, the top story first, preferring ones with a photo.
const tops = [top, ...friendly.filter((s) => s !== top && s.summary && s.image)].filter(Boolean).slice(0, 4);
const perSrc: Record<string, number> = {};
const rest = stories.filter((s) => !tops.includes(s)).filter((s) => (perSrc[s.source] = (perSrc[s.source] ?? 0) + 1) <= 3);
// Photo stories first, but photo-less ones (TOWERS, Silicon Hills) stay in the mix with a colored source tile.
const withPhoto = rest.filter((s) => s.image);
const noPhoto: typeof rest = [];
const noPic = rest.filter((s) => !s.image).slice(0, 1);
const latest = [...withPhoto.slice(0, noPic.length ? 3 : 4), ...noPic].slice(0, 4);
const pick = (cat: string) => stories.filter((s) => s.category === cat && s !== top).slice(0, 4);
const newsItems = pick('News').slice(0, 4);
const events = pick('Events').slice(0, 4);
const takes = withStory(all.stories.filter((s) => s.category !== 'Watch')).filter((r) => r.link || true).slice(0, 2);
const gov = pick('Government').slice(0, 3);
// Development: mix big-outlet stories about building and growth (KXAN, KVUE, Austin Monitor) with TOWERS, photos first.
const devWords = /(develop|construction|zoning|housing|apartment|high-?rise|tower|rezon|permit|site plan|mixed-use|redevelop|downtown|real estate|affordable|land use|planning commission|project|transit|rail|building)/i;
const devPool = stories.filter((s) => s !== top && !gov.includes(s) && s.category !== 'Events' && (s.category === 'Development' || (['KXAN', 'KVUE', 'Austin Monitor'].includes(s.source) && devWords.test(`${s.title} ${s.summary}`))));
const dev = [...devPool.filter((s) => s.image), ...devPool.filter((s) => !s.image)].slice(0, 3);
const hood = pick('Neighborhoods').slice(0, 4);
// What Matters Today: up to 3 non-crime stories, one per outlet, prefer government and development.
const used = new Set<string>();
const roundup = /(last update|everything you need to know|newsletter|week in review)/i;
const briefing = [...friendly.filter((s) => s !== top && (s.category === 'Government' || s.category === 'Development')), ...friendly.filter((s) => s !== top)]
  .filter((s) => !roundup.test(s.title))
  .filter((s) => (used.has(s.source) ? false : (used.add(s.source), true)))
  .slice(0, 3);
const taken = new Set([...tops, ...latest, ...noPhoto, ...briefing]);
const seenSrc = new Set<string>();
const featured = stories.filter((x) => x.image && !taken.has(x)).filter((x) => (seenSrc.has(x.source) ? false : (seenSrc.add(x.source), true))).slice(0, 3);
let ai: Awaited<ReturnType<typeof getAi>> = null;
if (tops.some((t) => !t.why)) {
  // Never hold the page for the AI: wait at most 1.5 seconds, let the call finish in the background so the next visit has it.
  const job = getAi((Astro.locals as any).runtime?.env, tops, briefing).catch(() => null);
  try { (Astro.locals as any).runtime?.ctx?.waitUntil(job); } catch {}
  ai = await Promise.race([job, new Promise<null>((r) => setTimeout(() => r(null), 1500))]);
}
const fmt = (d: Date) => d.getTime() ? d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' }) : '';
---
<Layout current="Home">
  {briefing.length > 0 && (
    <section class="wmt">
      <span class="lab" title="What matters today">Buzz</span>
      {briefing.map((s, i) => (
        <>{i > 0 && <span class="sep">•</span>}<a href={s.link} target="_blank" rel="noopener" title={s.title}>{ai?.briefing?.[i] || s.title}</a></>
      ))}
    </section>
  )}
  {top ? (
    <section class="lead">
      <div class="carousel" id="topcar">
        <div class="slides">
          {tops.map((t, i) => (
            <article class="hero slide">
              {t.image && <img src={t.image} alt="" referrerpolicy="no-referrer" fetchpriority={i === 0 ? 'high' : 'auto'} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />}
              <div class="kicker"><span class={`chip ${chipClass(t)}`}>{chipLabel(t)}</span>{i === 0 ? 'Top story' : 'Also big today'}</div>
              <h2><a href={t.link} rel="noopener" target="_blank">{t.title}</a></h2>
              <p>{t.summary}</p>
              <p><a href={t.link} rel="noopener" target="_blank">Read the full story at {t.source} →</a></p>
              <div class="why"><b>Why should I care?</b>{t.why ?? ai?.whys?.[i] ?? 'One plain sentence on what this means for people in Austin goes here soon.'}</div>
            </article>
          ))}
        </div>
        {tops.length > 1 && (
          <div class="carnav">
            <button type="button" class="prev" aria-label="Previous story">←</button>
            <span class="count">1 / {tops.length}</span>
            <button type="button" class="next" aria-label="Next story">→</button>
          </div>
        )}
      </div>
      <aside class="side">
        <h3>Latest</h3>
        {latest.map((s) => (
          <div class="item latest">{s.image ? <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <div class={`ph chip ${chipClass(s)}`}>{chipLabel(s)}</div>}<div><span><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span>{fmt(s.date)}</span><div><a href={s.link} rel="noopener" target="_blank">{s.title}</a></div></div></div>
        ))}
        {noPhoto.length > 0 && (
          <div class="more">
            <h3>More headlines</h3>
            <ul>{noPhoto.map((s) => (<li><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span><a href={s.link} rel="noopener" target="_blank">{s.title}</a></li>))}</ul>
          </div>
        )}
        <NewsletterTools />
      </aside>
    </section>
  ) : (
    <section class="page"><h2>Stories are on the way</h2><p>Check back soon.</p></section>
  )}

  {featured.length === 3 && (
    <section class="feat">
      <h3 class="rule">Featured</h3>
      <div class="featgrid">
        <a class="big" href={featured[0].link} target="_blank" rel="noopener">
          <img src={featured[0].image} alt="" loading="lazy" referrerpolicy="no-referrer" />
          <div class="cap"><span>{chipLabel(featured[0])}</span><b>{featured[0].title}</b></div>
        </a>
        <div class="smalls">
          {featured.slice(1).map((x) => (
            <a href={x.link} target="_blank" rel="noopener"><img src={x.image} alt="" loading="lazy" referrerpolicy="no-referrer" /><span class={`chip ${chipClass(x)}`}>{chipLabel(x)}</span><b>{x.title}</b></a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="pair">
    <div>
      <h3 class="section"><a href="/news">News</a></h3>
      {newsItems.map((s) => (
        <div class="mini">{s.image ? <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <div class={`ph chip ${chipClass(s)}`}>{chipLabel(s)}</div>}<div><a href={s.link} rel="noopener" target="_blank">{s.title}</a><small><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span></small></div></div>
      ))}
    </div>
    <div>
      <h3 class="section omgh"><a href="/omg">OMG!</a></h3>
      {takes.map((r) => (
        <div class="omgmini"><div class="hd">{r.head}{r.label && ` · ${r.label}`}</div><p><em>OMG!</em> {r.line}</p>{r.link && <a href={r.link} target="_blank" rel="noopener">Read the story →</a>}</div>
      ))}
      <p><a href="/omg">More OMG! →</a></p>
    </div>
  </section>

  <BannerBand />

  <section class="pair" style="margin-top:20px;padding-top:18px;border-top:1px solid #bdbab0">
    <div>
      <h3 class="section"><a href="/news?tag=Government">Government</a></h3>
      {gov.map((s) => (
        <div class="mini">{s.image ? <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <div class={`ph chip ${chipClass(s)}`}>{chipLabel(s)}</div>}<div><a href={s.link} rel="noopener" target="_blank">{s.title}</a><small><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span></small></div></div>
      ))}
    </div>
    <div>
      <h3 class="section"><a href="/news?tag=Development">Development</a></h3>
      {dev.map((s) => (
        <div class="mini">{s.image ? <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <div class={`ph chip ${chipClass(s)}`}>{chipLabel(s)}</div>}<div><a href={s.link} rel="noopener" target="_blank">{s.title}</a><small><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span></small></div></div>
      ))}
    </div>
  </section>

  <section class="pair" style="margin-top:20px;padding-top:18px;border-top:1px solid #bdbab0">
    <div>
      <h3 class="section"><a href="/watch">Watch</a></h3>
      {videos.length ? videos.map((v) => (
        <div class="mini"><a href="/watch" tabindex="-1" aria-hidden="true"><img src={v.image} alt="" loading="lazy" /></a><div><a href="/watch">{v.title}</a><small><span class={`chip ${chipClass(v)}`}>{chipLabel(v)}</span></small></div></div>
      )) : <p>Videos are on the way.</p>}
    </div>
    <div>
      <h3 class="section"><a href="/to-do">To Do</a></h3>
      {events.map((s) => (
        <div class="mini">{s.image ? <img src={s.image} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <div class={`ph chip ${chipClass(s)}`}>{chipLabel(s)}</div>}<div><a href={s.link} rel="noopener" target="_blank">{s.title}</a><small><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span></small></div></div>
      ))}
    </div>
  </section>

  {hood.length > 0 && (
    <section class="pair" style="margin-top:20px;padding-top:18px;border-top:1px solid #bdbab0;grid-template-columns:1fr">
      <div>
        <h3 class="section"><a href="/news?tag=Neighborhoods">Neighborhoods</a></h3>
        {hood.map((s) => (
          <div class="item"><span class={`chip ${chipClass(s)}`}>{chipLabel(s)}</span><div><a href={s.link} rel="noopener" target="_blank">{s.title}</a></div></div>
        ))}
      </div>
    </section>
  )}

  <TechEventsAd />

  <script is:inline>
    (function () {
      var car = document.getElementById('topcar');
      if (!car) return;
      var slides = car.querySelector('.slides');
      var count = car.querySelector('.count');
      var n = slides.children.length;
      function idx() { return Math.round(slides.scrollLeft / slides.clientWidth); }
      function go(i) { i = Math.max(0, Math.min(n - 1, i)); slides.scrollTo({ left: i * slides.clientWidth, behavior: 'smooth' }); }
      var p = car.querySelector('.prev'), x = car.querySelector('.next');
      if (p) p.addEventListener('click', function () { go(idx() - 1); });
      if (x) x.addEventListener('click', function () { go(idx() + 1); });
      slides.addEventListener('scroll', function () { if (count) count.textContent = (idx() + 1) + ' / ' + n; }, { passive: true });
    })();
  </script>
</Layout>
