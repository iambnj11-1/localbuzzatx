---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" current="About">
  <section class="page">
    <div class="pagehead"><h2>Contact</h2><span>Advertise, shout-outs, good news</span></div>
    <div class="omgcols">
      <div>
        <p>Want to advertise, send a shout-out, share good news, or just say hello? Fill this out and we will get back to you.</p>
        <iframe class="formframe" src="https://tally.so/embed/2jaBxA?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1" title="Contact Local Buzz ATX" loading="lazy"></iframe>
        <p><small>Prefer the form on its own page? <a href="https://tally.so/r/2jaBxA" target="_blank" rel="noopener">Open it here</a>.</small></p>
      </div>
      <aside class="omgside">
        <div class="sendbox"><b>Shout-outs and good news</b>Birthdays, congrats, thank-yous and neighborhood wins. Pick the option in the form.</div>
        <div class="sponsor"><div class="label">Advertise</div><b>Reach Austin readers</b>Local Buzz ATX readers care about what is happening in Austin. Pick "Advertise" in the form.</div>
      </aside>
    </div>
  </section>
</Layout>
