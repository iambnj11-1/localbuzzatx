---
import Layout from '../layouts/Layout.astro';
import AdRow from '../components/AdRow.astro';
import { FEEDS, PAGES } from '../lib/feeds';
const home: Record<string, string> = { 'City of Austin': 'https://www.austintexas.gov/news', 'Community Impact': 'https://communityimpact.com/austin/', KXAN: 'https://www.kxan.com', KVUE: 'https://www.kvue.com', 'Austin Monitor': 'https://www.austinmonitor.com', TOWERS: 'https://austin.towers.net', '365 Things Austin': 'https://365thingsaustin.com', 'Austin Monthly': 'https://austinmonthly.com', 'Silicon Hills News': 'https://siliconhillsnews.com', 'Spectrum News Austin': 'https://spectrumlocalnews.com/tx/austin', 'West Austin News': 'https://westaustinnews.com', Austonia: 'https://austonia.com', Variety: 'https://variety.com', Deadline: 'https://deadline.com', 'Black Austin Matters': 'https://kutkutx.studio/category/black-austin-matters', 'Austin Business Journal': 'https://www.bizjournals.com/austin' };
const names = [...new Set([...FEEDS.filter((f) => f.category !== 'Entertainment'), ...PAGES].map((f) => f.source))];
---
<Layout title="Sources" current="About">
  <section class="page">
    <h2>Sources</h2>
    <p>Local Buzz ATX shows headlines and short summaries from these outlets. Every link goes to the original reporting.</p>
    <ul>{names.map((n) => <li>{home[n] ? <a href={home[n]} target="_blank" rel="noopener">{n}</a> : n}</li>)}</ul>
    <AdRow />
  </section>
</Layout>
