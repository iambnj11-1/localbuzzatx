---
import Layout from '../layouts/Layout.astro';
import * as feeds from '../lib/feeds';
import * as aiLib from '../lib/ai';
await feeds.getStories(true);
const report = [...feeds.lastReport];
import { aiStats } from '../lib/store';
const tagRun = await aiLib.enrich(15);
const stats = await aiStats();
const envNames = [...new Set([...Object.keys((Astro.locals as any).runtime?.env ?? {}), ...(typeof process !== 'undefined' ? Object.keys(process.env ?? {}) : [])])].filter((k) => !/^(npm_|NODE_|PATH|HOME)/.test(k)).sort();
const hasKey = Boolean((Astro.locals as any).runtime?.env?.ANTHROPIC_API_KEY);
---
<Layout title="Feed status">
  <section class="page">
    <h2>Feed status</h2>
    <p>For checking which sources load. Each row is one feed address.</p>
    {report.map((r) => (
      <div class="item"><b>{r.source}{r.area ? ` · ${r.area}` : ''}</b> — status {r.status}, {r.count} stories, {r.ms} ms<br /><span style="word-break:break-all">{r.url}</span>{r.note && <><br /><span style="font-size:12px;color:var(--muted)">Got: {r.note}</span></>}</div>
    ))}
    <div class="item"><b>AI lines</b> — key found: {hasKey ? 'yes' : 'no'}<br /><span style="font-size:12px;color:var(--muted)">Last result: {aiLib.lastAiNote} (updates when the homepage loads)</span></div>
    <div class="item"><b>AI story notes (saved in the database)</b> — {stats ? `${stats.done} of ${stats.stories} stories tagged` : 'database not connected'}<br /><span style="font-size:12px;color:var(--muted)">This visit: {tagRun}. Last saved result: {stats?.last ?? 'n/a'}</span></div>
    <div class="item"><b>Settings the site can see</b> (names only)<br /><span style="font-size:13px;color:var(--muted)">{envNames.length ? envNames.join(', ') : 'none'}</span></div>
    {!report.length && <p>No fresh check was run (results are saved for 10 minutes). Reload in a few minutes.</p>}
  </section>
</Layout>
