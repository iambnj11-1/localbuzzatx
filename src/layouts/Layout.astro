---
import { FEEDS } from '../lib/feeds';
const home: Record<string, string> = { KXAN: 'https://www.kxan.com', KVUE: 'https://www.kvue.com', 'Austin Monitor': 'https://www.austinmonitor.com', TOWERS: 'https://austin.towers.net', '365 Things Austin': 'https://365thingsaustin.com', 'Austin Monthly': 'https://austinmonthly.com', 'Silicon Hills News': 'https://siliconhillsnews.com', 'Spectrum News Austin': 'https://spectrumlocalnews.com/tx/austin', 'West Austin News': 'https://westaustinnews.com', Austonia: 'https://austonia.com', 'Black Austin Matters': 'https://kutkutx.studio/category/black-austin-matters', 'Austin Business Journal': 'https://www.bizjournals.com/austin' };
const footSources = [...new Set(FEEDS.map((f) => f.source))].map((n) => [n, home[n] ?? '/sources'] as [string, string]);
import '../styles/global.css';
import { getWeather } from '../lib/weather';
const { title = 'Local Buzz ATX', current = '' } = Astro.props;
const sections: [string, string, [string, string][]][] = [
  ['News', '/news', [['Latest', '/news'], ['Government', '/news?tag=Government'], ['Neighborhoods', '/news?tag=Neighborhoods'], ['Business', '/news?tag=Business'], ['Tech', '/news?tag=Tech'], ['Busted', '/news?tag=Busted'], ['Weather', '/news?tag=Weather']]],
  ['Watch', '/watch', []],
  ['OMG!', '/omg', [['Latest', '/omg'], ['Good News', '/omg?tag=Good News'], ['Shout-Outs', '/omg?tag=Shout-Outs']]],
  ['Money', '/money', []],
  ['To Do', '/to-do', [['This Weekend', '/to-do'], ['Live Music', '/to-do?tag=Live Music'], ['Food & Drink', '/to-do?tag=Food %26 Drink'], ['Family Fun', '/to-do?tag=Family Fun'], ['Free Stuff', '/to-do?tag=Free Stuff']]],
  ['About', '/about', [['About', '/about'], ['Contact', '/contact'], ['Sources', '/sources']]],
];
const weather = await getWeather();
const today = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Local Buzz ATX' ? title : `${title} | Local Buzz ATX`}</title>
    <meta name="description" content="Austin news, and why it matters to you." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Local Buzz ATX" />
    <meta property="og:title" content={title === 'Local Buzz ATX' ? 'Local Buzz ATX' : `${title} | Local Buzz ATX`} />
    <meta property="og:description" content="Austin news, and why it matters to you." />
    <meta property="og:image" content={new URL('/og.png', Astro.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:wght@900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="wrap">
      {weather?.alert && (
        <div class="alertbar"><b>Weather alert:</b> {weather.alert}</div>
      )}
      <div class="dateline"><span>{today}</span><span>{weather && <b class="wx">{weather.temp}° · {weather.summary}</b>}{weather ? ' ' : ''}Austin, Texas</span></div>
      <header class="masthead">
        <a href="/"><h1>Local Buzz ATX<span class="dot">.</span></h1></a>
        <p class="tagline">Austin news, and why it matters to you.</p>
      </header>
      <nav class="sections" aria-label="Sections">
        <ul>
          {sections.map(([label, href, kids]) => (
            <li class="dd">
              <a href={href} aria-current={current === label ? 'page' : undefined} aria-haspopup={kids.length ? 'true' : undefined}>{label}{kids.length > 0 && <span class="caret"> ▾</span>}</a>
              {kids.length > 0 && (
                <ul class="menu">
                  {kids.map(([text, to]) => (
                    <li><a href={to} {...(to.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{text}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <main><slot /></main>
      <footer class="site">
        <div class="cols">
          <div class="brand">
            <b>Local Buzz ATX<span>.</span></b>
            <p>Austin news, and why it matters to you.</p>
            <p>Headlines are curated from trusted Austin-area publishers. Every story links directly to the original reporting.</p>
          </div>
          <div>
            <h5>Explore</h5><ul><li><a href="/news">News</a></li><li><a href="/watch">Watch</a></li><li><a href="/omg">OMG!</a></li><li><a href="/money">Money</a></li><li><a href="/to-do">To Do</a></li></ul>
            <h5 style="margin-top:18px">Mind the Marbles</h5><ul><li><a href="https://www.instagram.com/mindthemarbles/" target="_blank" rel="noopener">Instagram</a></li></ul>
          </div>
          <div><h5>Sources</h5><ul>{footSources.map(([n, u]) => <li><a href={u} target="_blank" rel="noopener">{n} →</a></li>)}</ul><a href="/sources" class="more">View all sources →</a></div>
          <div>
            <h5>Learn</h5><ul><li><a href="/how-it-works">How Local Buzz works</a></li><li><a href="/sources">Sources</a></li><li><a href="/about">About</a></li><li><a href="/contact">Contact</a></li></ul>
            <h5 style="margin-top:18px">Legal</h5><ul><li><a href="/privacy">Privacy policy</a></li><li><a href="/terms">Terms of use</a></li><li><a href="/affiliate-disclosure">Affiliate disclosure</a></li></ul>
          </div>
        </div>
        <div class="fine">
          <div>© {new Date().getFullYear()} Local Buzz ATX</div>
          <div>Some links may be affiliate links. If you make a purchase through them, Local Buzz ATX may earn a commission at no additional cost to you. Headlines and summaries link to the original reporting.</div>
        </div>
      </footer>
    </div>
  </body>
</html>
