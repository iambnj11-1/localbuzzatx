---
import { FEEDS, PAGES } from '../lib/feeds';
const home: Record<string, string> = { 'City of Austin': 'https://www.austintexas.gov/news', 'Community Impact': 'https://communityimpact.com/austin/', KXAN: 'https://www.kxan.com', KVUE: 'https://www.kvue.com', 'Austin Monitor': 'https://www.austinmonitor.com', TOWERS: 'https://austin.towers.net', '365 Things Austin': 'https://365thingsaustin.com', 'Austin Monthly': 'https://austinmonthly.com', 'Silicon Hills News': 'https://siliconhillsnews.com', 'Spectrum News Austin': 'https://spectrumlocalnews.com/tx/austin', 'West Austin News': 'https://westaustinnews.com', Austonia: 'https://austonia.com', Variety: 'https://variety.com', Deadline: 'https://deadline.com', 'Black Austin Matters': 'https://kutkutx.studio/category/black-austin-matters', 'Austin Business Journal': 'https://www.bizjournals.com/austin' };
const footSources = [...new Set([...FEEDS.filter((f) => f.category !== 'Entertainment'), ...PAGES].map((f) => f.source))].map((n) => [n, home[n] ?? '/sources'] as [string, string]);
import '../styles/global.css';
import { getWeather } from '../lib/weather';
const { title = 'Local Buzz ATX', current = '', navV2 = true, noindex = false } = Astro.props;
const sections: [string, string, [string, string][]][] = [
  ['News', '/news', [['Latest', '/news'], ['Government', '/news?tag=Government'], ['Neighborhoods', '/news?tag=Neighborhoods'], ['Business', '/news?tag=Business'], ['Tech', '/news?tag=Tech'], ['Crime', '/news?tag=Busted'], ['Weather', '/news?tag=Weather']]],
  ['Watch', '/watch', []],
  ['OMG!', '/omg', [['Latest', '/omg'], ['Good News', '/omg?tag=Good News'], ['Shout-Outs', '/omg?tag=Shout-Outs']]],
  ['Money', '/money', []],
  ['To Do', '/to-do', [['This Weekend', '/to-do'], ['Live Music', '/to-do?tag=Live Music'], ['Food & Drink', '/to-do?tag=Food %26 Drink'], ['Family Fun', '/to-do?tag=Family Fun'], ['Free Stuff', '/to-do?tag=Free Stuff']]],
  ['About', '/about', [['About', '/about'], ['Contact', '/contact'], ['Sources', '/sources']]],
];
const sectionsV2: [string, string, [string, string][]][] = [
  ['News', '/news', [['Latest', '/news'], ['Government', '/news?tag=Government'], ['Business', '/news?tag=Business'], ['Development', '/news?tag=Development'], ['Weather', '/news?tag=Weather']]],
  ['Watch', '/watch', []],
  ['Community', '/shout-out', [['Events', '/to-do'], ['Guides', '/guides'], ['Shout-Outs', '/shout-out'], ['OMG!', '/omg'], ['Submit something', '/contact']]],
  ['Blog', '/blog', [['Caleb\'s Corner', '/blog/caleb'], ['Quick Tea with Tori', '/blog/tori'], ['Mind the Marbles', '/mind-the-marbles']]],
  ['About', '/about', [['Meet the Buzz', '/blog'], ['Advertise', '/advertise'], ['Contact', '/contact'], ['Newsletter', '/morning-buzz']]],
];
const footResources: [string, string][] = [
  ['Austin Free-Net', 'https://www.austinfree.net/'],
  ['Austin Public Library', 'https://library.austintexas.gov/'],
  ['Round Rock Public Library', 'https://www.roundrocktexas.gov/city-departments/library-home/'],
  ['Georgetown Public Library', 'https://library.georgetown.org/'],
  ['Integral Care', 'https://integralcare.org/'],
  ['Ready Central Texas', 'https://austintexas.gov/ready-central-texas'],
];
const navSections = navV2 ? sectionsV2 : sections;
const weather = await getWeather();
// Only the real domain is open to search engines and ads. beta and local stay private.
const live = ['localbuzzatx.com', 'www.localbuzzatx.com'].includes(Astro.url.hostname);
const today = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Local Buzz ATX' ? title : `${title} | Local Buzz ATX`}</title>
    <meta name="description" content="Local news, practical guides and tech help for Austin and Central Texas. What’s happening, and why it matters." />
    <meta name="fo-verify" content="c5f0822f-7460-4261-b7d8-f1081d3822da" />
    <meta name="impact-site-verification" value="0ffa0d16-8615-4c4c-a219-13b8f51c5ab5" />
    {!live && <meta name="robots" content="noindex, nofollow" />}
    {live && noindex && <meta name="robots" content="noindex, follow" />}
    {live && <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2767848856450502" crossorigin="anonymous"></script>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Local Buzz ATX" />
    <meta property="og:title" content={title === 'Local Buzz ATX' ? 'Local Buzz ATX' : `${title} | Local Buzz ATX`} />
    <meta property="og:description" content="Local news, practical guides and tech help for Austin and Central Texas. What’s happening, and why it matters." />
    <meta property="og:image" content={new URL('/og.png', Astro.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:wght@900&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:wght@900&display=swap" rel="stylesheet" /></noscript>
  </head>
  <body>
    <div class="wrap">
      {weather?.alert && (
        <div class="alertbar"><b>Weather alert:</b> {weather.alert}</div>
      )}
      <div class="dateline"><span>{today}</span><span>{weather && <b class="wx">{weather.temp}° · {weather.summary}</b>}{weather ? ' ' : ''}Austin, Texas</span></div>
      <header class="masthead">
        <a href="/"><h1>Local Buzz ATX<span class="dot">.</span></h1></a>
        <p class="tagline">What’s Happening. Why It Matters.</p>
      </header>
      <nav class="sections" id="stickynav" aria-label="Sections">
        <a class="minilogo" href="/" aria-label="Local Buzz ATX home">Local Buzz ATX<span>.</span></a>
        <ul>
          {navSections.map(([label, href, kids]) => (
            <li class="dd">
              <a href={href} aria-current={current === label ? 'page' : undefined} aria-haspopup={kids.length ? 'true' : undefined}>{label}{kids.length > 0 && <span class="caret"> ▾</span>}</a>
              {kids.length > 0 && (
                <ul class="menu">
                  {kids.map(([text, to]) => (
                    <li><a href={to} {...(to.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{text}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
          {!navV2 && <li class="navcta"><a href="/shout-out">Shout-Out</a></li>}
        </ul>
        {weather && <span class="mininow">{weather.temp}° {weather.summary}</span>}
      </nav>
      <main><slot /></main>
      <script is:inline>
        (function () {
          var nav = document.getElementById('stickynav'), head = document.querySelector('.masthead');
          if (!nav || !head || !('IntersectionObserver' in window)) return;
          new IntersectionObserver(function (e) { nav.classList.toggle('stuck', !e[0].isIntersecting); }, { rootMargin: '0px 0px 0px 0px', threshold: 0 }).observe(head);
        })();
      </script>
      <footer class="site">
        <div class="cols">
          <div class="brand">
            <b>Local Buzz ATX<span>.</span></b>
            <p>What’s Happening. Why It Matters.</p>
            <p>Headlines are curated from trusted Austin-area publishers. Every story links directly to the original reporting.</p>
          </div>
          <div>
            <h4 class="fh">Explore</h4><ul><li><a href="/news">News</a></li><li><a href="/watch">Watch</a></li><li><a href="/omg">OMG!</a></li><li><a href="/money">Money</a></li><li><a href="/to-do">To Do</a></li><li><a href="/blog">Blog</a></li><li><a href="https://local-buzz-atx-shop.fourthwall.com" target="_blank" rel="noopener">Shop (coming soon) →</a></li></ul>
            <h4 class="fh" style="margin-top:18px">Mind the Marbles</h4><ul><li><a href="/mind-the-marbles">Read the column →</a></li></ul>
          </div>
          <div><h4 class="fh">Sources</h4><ul>{footSources.map(([n, u]) => <li><a href={u} target="_blank" rel="noopener">{n} →</a></li>)}</ul><a href="/sources" class="more">View all sources →</a>
            <h4 class="fh" style="margin-top:18px">Community Resources</h4><ul>{footResources.map(([n, u]) => <li><a href={u} target="_blank" rel="noopener">{n} →</a></li>)}</ul><a href="/resources" class="more">View all resources →</a></div>
          <div>
            <h4 class="fh">Learn</h4><ul><li><a href="/how-it-works">How Local Buzz works</a></li><li><a href="/corrections">Corrections</a></li><li><a href="/sources">Sources</a></li><li><a href="/about">About</a></li><li><a href="/contact">Contact</a></li></ul>
            <h4 class="fh" style="margin-top:18px">Legal</h4><ul><li><a href="/privacy">Privacy policy</a></li><li><a href="/terms">Terms of use</a></li><li><a href="/affiliate-disclosure">Affiliate disclosure</a></li></ul>
          </div>
        </div>
        <div class="fine">
          <div>© {new Date().getFullYear()} Local Buzz ATX</div>
        </div>
      </footer>
    </div>
  </body>
</html>
