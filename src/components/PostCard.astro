---
import { authors, fmtDate, laneBadge, readMin, reactingTo, type Post } from '../lib/posts';
const { post } = Astro.props as { post: Post };
const a = authors[post.author];
const react = post.lane === 'Caleb Reports' ? reactingTo(post) : undefined;
const cov = post.cardCover ? { src: post.cardCover, alt: post.cover?.alt ?? '', portrait: true } : post.cover;
const noimg = post.author === 'caleb' && !post.cover;
const href = `${a.path}/${post.slug}${post.draft ? '?preview=1' : ''}`;
---
{(post.teaser || post.cardCover) ? (
<a class={`pcard pcteaser${cov?.portrait ? ' pcteaser-img' : ''}${cov && !cov.portrait ? ' pcteaser-photo' : ''}`} href={href}>
  {cov && (cov.portrait
    ? <img class="pcteaser-cover" src={cov.src} alt={cov.alt} loading="lazy" width="896" height="1200" />
    : <img class="pcteaser-wide" src={cov.src} alt={cov.alt} loading="lazy" width="1400" height="933" />)}
  <span class="pctag">{laneBadge(post.lane)}</span>
  <h3>{post.title}</h3>
  <p>{post.dek}</p>
  <div class="pcmeta"><img src={a.img} alt="" width="24" height="24" /><span>By {a.name}</span><span>🕒 {readMin(post)} min read</span></div>
  <span class="takebtn">{post.teaser ? (post.author === 'tori' ? 'Tori’s thoughts coming soon' : 'Coming soon') : 'Read More →'}</span>
</a>
) : (
<a class={`pcard pc-${post.author}${noimg ? ' pc-noimg' : ''}`} href={href}>
  {post.cover
    ? <img class="pcimg" src={post.cover.src} alt={post.cover.alt} loading="lazy" width="1400" height="933" />
    : noimg ? null : <div class="pcimg pctxt"><span>{laneBadge(post.lane)}</span></div>}
  <span class="pctag">{laneBadge(post.lane)}</span>
  <h3>{post.title}</h3>
  <p>{post.dek}</p>
  {react && <small class="pcreact">Reacting to: <b>{react.label}</b></small>}
  <div class="pcmeta"><img src={a.img} alt="" width="24" height="24" /><span>By {a.name}</span><span>🕒 {readMin(post)} min read</span><span>{fmtDate(post.date)}</span></div>
</a>
)}
