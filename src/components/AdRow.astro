---
// One slim, fixed-height "Advertise with us" strip. It never changes size, so a late or missing ad can't move the page.
// To sell the spot: swap the text and link for the advertiser's. The label must stay.
const { line = 'Reach Austin readers every day. Local businesses welcome.', go = 'See how →', href = '/advertise' } = Astro.props;
---
<aside class="adstrip" aria-label="Advertisement">
  <span class="k">Advertise with us</span>
  <b>{line}</b>
  <a class="go" href={href}>{go}</a>
</aside>
