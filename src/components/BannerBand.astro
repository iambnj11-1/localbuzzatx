---
import AdRow from './AdRow.astro';
import NewsletterTools from './NewsletterTools.astro';
// Banner between homepage sections: Advertise strip, OMG!, Mind the Marbles (the Morning Buzz signup now sits under the hero).
---
<section class="band" aria-label="More from Local Buzz ATX">
  <AdRow />
  <NewsletterTools />
  <a class="tile hot" href="/omg">
    <span class="k">OMG!</span>
    <b>The stuff Austin can't stop talking about.</b>
    <p>Quick takes and big reactions on the wildest stories of the day.</p>
    <span class="go">Get the OMG! →</span>
  </a>
  <a class="tile dark" href="https://www.instagram.com/mindthemarbles/" target="_blank" rel="noopener">
    <span class="k">From Mind the Marbles</span>
    <b>Real talk about the stuff rattling around in your head.</b>
    <span class="go">Follow on Instagram →</span>
  </a>
</section>
