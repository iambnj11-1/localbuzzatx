---
// Closing band for author pages: the top story (heading is its category), a topic box, and the sponsor box.
type S = { title: string; summary?: string; why?: string; image?: string; source: string; link: string; category?: string };
const { story, side } = Astro.props as { story?: S; side?: { label: string; title: string; why?: string; source: string; link: string; own: boolean } };
const adUrl = 'https://tolt.link/lba';
const icons: Record<string, string> = { Money: '💵', Business: '💼', Government: '🏛️', Tech: '💻', Development: '🏗️', Neighborhoods: '🏘️', Busted: '🚔', Events: '🎟️' };
const cat = story?.category ?? 'News';
const heading = cat === 'News' ? 'Top Austin Story' : cat;
const icon = icons[cat] ?? '📍';
---
<section class="tsection bband">
  <div class="prowhead"><h3>{icon} {heading}</h3><span>The story to know right now.</span></div>
  <div class="bgrid">
    {story && (
      <a class="bfeat" href="/news">
        {story.image
          ? <img src={story.image} alt="" loading="lazy" />
          : <div class="bfeat-ph"><span>Local Buzz ATX</span></div>}
        <span class="pctag">{heading}</span>
        <h3>{story.title}</h3>
        {story.why && <p>{story.why}</p>}
        <small>Source: {story.source}</small>
        <span class="takebtn">See all Austin news →</span>
      </a>
    )}
    <aside class="bside">
      {side && (
        <a class="btopic" href={side.link} target={side.own ? undefined : '_blank'} rel={side.own ? undefined : 'noopener'}>
          <span class="pctag">{side.label}</span>
          <h4>{side.title}</h4>
          {side.why && <p>{side.why}</p>}
          <small>{side.own ? 'By ' : 'Source: '}{side.source}</small>
        </a>
      )}
      <div class="bad">
        <span class="pctag">Sponsored</span>
        <h4>Start your own newsletter</h4>
        <p>EmailOctopus is free for your first 2,500 subscribers.</p>
        <a class="cta" href={adUrl} target="_blank" rel="sponsored noopener">Try EmailOctopus →</a>
        <small>Affiliate link. Local Buzz ATX may earn a commission at no cost to you.</small>
      </div>
    </aside>
  </div>
</section>
